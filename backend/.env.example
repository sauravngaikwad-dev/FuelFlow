# FuelFlow Environment Configuration
# Copy this file to .env and fill in real values

ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# SQLite persistent database file path
DATABASE_URL=sqlite:///./fuelflow.db

# Security & Authentication
# Generate a secure secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Storage paths
UPLOAD_DIR=./uploads
YOLO_MODEL_PATH=./models/yolov8n.pt
